# ---- Site ----
SITE_URL=https://dragonwarriors.app
APP_NAME="Dragon Warriors"
GUILD_SLUG=dragon-warriors          # Forever guild slug (realmless)
REGION=us                           # us | eu | kr | tw
FOREVER_PROFILE_NS=profile-forever-us
FOREVER_STATIC_NS=static-forever-us
FOREVER_DYNAMIC_NS=dynamic-forever-us

# ---- Battle.net (develop.battle.net → API Access → Create Client) ----
# Redirect URLs to register on the client:
#   https://dragonwarriors.app/auth/battlenet/callback
#   http://localhost:3000/auth/battlenet/callback   (local dev)
BNET_CLIENT_ID=
BNET_CLIENT_SECRET=
BNET_REDIRECT_URI=https://dragonwarriors.app/auth/battlenet/callback

# ---- Warcraft Logs (warcraftlogs.com/api/clients) ----
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=
WCL_GUILD_ID=

# ---- Discord (discord.com/developers) ----
# OAuth redirect: https://dragonwarriors.app/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://dragonwarriors.app/auth/discord/callback
DISCORD_BOT_TOKEN=
DISCORD_SIGNUPS_WEBHOOK_URL=

# ---- App ----
DATABASE_URL=postgres://user:pass@localhost:5432/dragonwarriors
# SESSION_SECRET is not used: sessions are random ids stored in the `sessions` table.
COOKIE_DOMAIN=dragonwarriors.app
CORS_ORIGINS=https://dragonwarriors.app,https://www.dragonwarriors.app

# ---- Jobs ----
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/* (see vercel.json)
CRON_SECRET=change-me
# Set to "false" if your Postgres doesn't use TLS (local dev is detected automatically)
DATABASE_SSL=
