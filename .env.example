# Production settings live in wrangler.jsonc ("vars") and Worker secrets.
# For local development copy .dev.vars.example to .dev.vars instead.
# This file lists every key the hub reads, for reference.

# ---- Site (wrangler.jsonc vars) ----
SITE_URL=https://dragonwarriors.app
APP_NAME="Dragon Warriors"
GUILD_SLUG=dragon-warriors
REGION=us
BNET_REDIRECT_URI=https://dragonwarriors.app/auth/battlenet/callback
DISCORD_REDIRECT_URI=https://dragonwarriors.app/auth/discord/callback
COOKIE_DOMAIN=dragonwarriors.app

# ---- Secrets (wrangler secret put NAME) ----
BNET_CLIENT_ID=
BNET_CLIENT_SECRET=
CRON_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_SIGNUPS_WEBHOOK_URL=
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=
WCL_GUILD_ID=
PROFILE_SYNC_LIMIT=7
